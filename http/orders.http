
### 1. Get first customer
GET http://localhost:8080/customers/1

> {%
    client.log(JSON.stringify(response.body, null, 2));
    client.global.set("customerId", response.body.id);
%}

### 2. Get first customer shipping address
GET http://localhost:8080/customers/{{customerId}}/address

> {%
    client.log(JSON.stringify(response.body, null, 2));
    client.global.set("addressId", response.body.id);
%}

### 3. Create order
POST http://localhost:8080/customers/{{customerId}}/orders?shippingAddressId={{addressId}}
Content-Type: application/json

[
  {"productId": 2, "quantity": 2},
  {"productId": 3, "quantity": 1}
]

> {%
    client.log(JSON.stringify(response.body, null, 2));
    client.global.set("orderId", response.body.id);
%}

### 4. Get new order by id
GET http://localhost:8080/orders/{{orderId}}

> {%
    client.log(JSON.stringify(response.body, null, 2));
%}

### 5. Get customer orders (verify new order exists)
GET http://localhost:8080/customers/{{customerId}}/orders

> {%
    client.log(JSON.stringify(response.body, null, 2));
%}

### 6. Get order items
GET http://localhost:8080/orders/{{orderId}}/items

> {%
    client.log(JSON.stringify(response.body, null, 2));
    client.global.set("productId", response.body[0].productId);
%}

### 7. Change product quantity
PUT http://localhost:8080/orders/{{orderId}}/items/{{productId}}
Content-Type: application/json

{"quantity": 10}

> {%
    client.log(JSON.stringify(response.body, null, 2));
%}

### 8. Get order items
GET http://localhost:8080/orders/{{orderId}}/items

> {%
    client.log(JSON.stringify(response.body, null, 2));
%}

### 9. Get customer order totals
GET http://localhost:8080/customers/{{customerId}}/orders/totals

> {%
    client.log(JSON.stringify(response.body, null, 2));
%}
